{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.js"
    },
    {
      "name": "Open Browser",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "start http://localhost:3000"]
    }
  ],
  "compounds": [
    {
      "name": "Run Full App",
      "configurations": ["Run Server", "Open Browser"]
    }
  ]
}